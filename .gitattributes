*.aar   filter=lfs diff=lfs merge=lfs -text
*.zip   filter=lfs diff=lfs merge=lfs -text

# -----------------------------------------------------------------------------
# Unity-specifikt: dessa ska vara text (kräver Asset Serialization = Force Text)
# -----------------------------------------------------------------------------
*.cs         text eol=lf diff=csharp
*.shader     text eol=lf
*.shadergraph text eol=lf
*.compute    text eol=lf
*.cginc      text eol=lf
*.hlsl       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.mat        text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.physicMaterial text eol=lf
*.asmdef     text eol=lf
*.inputactions text eol=lf

# Vanliga textformat
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
